{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@minerva/server/*": ["../server/src/*"]
    }
  },
  "include": ["src", "../server/src/sync/trpc-router.ts", "../server/src/sync/trpc.ts"]
}
